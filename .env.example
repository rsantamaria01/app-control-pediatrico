# Copy to .env for a prod-like `docker compose --profile full up`. Never commit .env.
DB_PASSWORD=change-me
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-at-least-8-chars
# Set NUXT_APP_SECRET to a random 32+ character secret; NUXT_PUBLIC_SITE_URL is the externally configured HTTPS origin.
# NUXT_APP_SECRET=<operator-generated-random-secret>
# NUXT_PUBLIC_SITE_URL=https://<deployment-host>
# SMTP_HOST / SMTP_PORT / SMTP_FROM / SMTP_SECURE=true|false; SMTP_USER and SMTP_PASS must both be provided for authenticated SMTP.
# REDIS_URL points to Valkey. Do not set SMTP to a test transport outside the devcontainer.
# REDIS_URL=redis://cache:6379
# RECOVERY_QUEUE_SECRET=<operator-generated-32-random-bytes-as-64-hex-digits> (keep stable across restarts; rotate only after draining queued recovery requests)
# Proxy must overwrite X-Forwarded-For and restrict direct app access; configure AUTH_TRUSTED_PROXY_CIDR to the exact trusted proxy IP/CIDR only after this is enforced. Without it, untrusted forwarded headers are ignored and production callers share a conservative IP bucket.
# First deployment only, after migrations and before the first login:
# BOOTSTRAP_ADMIN_USERNAME=<username> BOOTSTRAP_ADMIN_EMAIL=<email> pnpm bootstrap:admin
# Bootstrap creates one ADMIN identity, prints a single-use 7-day setup URL and refuses to run again; no default password.
# Agent keys (OMNIROUTE_API_KEY, HINDSIGHT_API_KEY) live on the dev host in
# /root/.config/app-monitoreo-pediatrico/secrets.env, loaded by the devcontainer.
